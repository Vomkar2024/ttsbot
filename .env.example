# Discord Bot Credentials
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here


# Development guild ID (Optional - leave empty for global commands)
DISCORD_GUILD_ID=

# eSpeak NG executable name or full binary path (Default: espeak-ng)
# On Windows, e.g. "C:\Program Files\eSpeak NG\espeak-ng.exe" or "espeak-ng"
TTS_BIN=espeak-ng

# FFmpeg executable path (Default: ffmpeg on PATH)
FFMPEG_PATH=ffmpeg

# Persistent SQLite database file path (Default: ./data/voicebridge.sqlite)
DATABASE_PATH=./data/voicebridge.sqlite

# Whether to prefix each message with the sender's display name (Default: true)
SPEAK_USERNAMES=true

# Maximum waiting messages per server, excluding active item (Default: 50)
MAX_QUEUE_SIZE=50

# Maximum message characters sent to local TTS engine (Default: 800)
MAX_MESSAGE_CHARS=800

# Voice connection ready timeout in milliseconds (Default: 15000)
VOICE_READY_TIMEOUT_MS=15000

# Grace period for temporary voice disconnects before session cleanup (Default: 8000)
VOICE_DISCONNECT_GRACE_MS=8000
