# Discord Bot Credentials
# Obtain from Discord Developer Portal: https://discord.com/developers/applications
# IMPORTANT: Do NOT put quotation marks around DISCORD_TOKEN!
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here


# Development guild ID (Optional - leave empty for global commands)
DISCORD_GUILD_ID= 

# Primary TTS Engine (Default: gtts)
# Options: "gtts" (Google Translate TTS - clear, natural, human voice) or "espeak" (eSpeak NG offline)
TTS_ENGINE=gtts

# eSpeak NG executable name or full binary path (Default: espeak-ng)
# Used as offline fallback or when TTS_ENGINE=espeak
# On Linux / Bot Hosting: keep as "espeak-ng" (or "espeak")
# On Windows: leave as "espeak-ng" (auto-detected) or specify full path "C:\Program Files\eSpeak NG\espeak-ng.exe"
TTS_BIN=espeak-ng

# FFmpeg executable path (Default: ffmpeg on PATH)
FFMPEG_PATH=ffmpeg

# Persistent SQLite database file path (Default: ./data/tts.sqlite)
DATABASE_PATH=./data/tts.sqlite

# Whether to prefix each message with the sender's display name (Default: true)
SPEAK_USERNAMES=true

# Speaker announcement cooldown in seconds (Default: 60)
# Prevents repeating "Alice says:" for rapid consecutive messages by the same user
SPEAKER_COOLDOWN_SEC=60

# Maximum waiting messages per server, excluding active item (Default: 50)
MAX_QUEUE_SIZE=50

# Maximum message characters sent to local TTS engine (Default: 800)
MAX_MESSAGE_CHARS=800

# Voice connection ready timeout in milliseconds (Default: 15000)
VOICE_READY_TIMEOUT_MS=15000

# Grace period for temporary voice disconnects before session cleanup (Default: 8000)
VOICE_DISCONNECT_GRACE_MS=8000

# Whether to announce links in chat messages (e.g., "Alice sent a link") (Default: true)
ANNOUNCE_LINKS=true

# Online gTTS request timeout in seconds before falling back to eSpeak NG (Default: 5.0)
GTTS_TIMEOUT_SEC=5.0
